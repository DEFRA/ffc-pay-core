#!/usr/bin/env bash

set -euo pipefail

# ----------------- Config ----------------- #
config_file="$HOME/.bashrc_setup.conf"

# Load saved inputs if they exist
if [[ -f "$config_file" ]]; then
  # shellcheck source=/dev/null
  source "$config_file"
fi

# Check for -r flag to delete config file
if [[ "${1:-}" == "-r" ]]; then
  if [[ -f "$config_file" ]]; then
    rm -f "$config_file"
    echo "🧹 Removed saved configuration: $config_file"
  else
    echo "ℹ️ No configuration file found to remove."
  fi
  exit 0
fi

# Prompt for any missing values
inputEmpty=false

prompt_if_empty() {
  local var_name=$1
  local prompt_msg=$2
  if [[ -z "${!var_name:-}" ]]; then
    read -rp "$prompt_msg" val
    declare -g "$var_name"="$val"
    inputEmpty=true
  fi
}

prompt_if_empty KEYVAULT   "Enter Key Vault name: "
prompt_if_empty EMAIL      "Enter your email: "
prompt_if_empty SUFFIX     "Enter your Service Bus suffix (no leading dash): "

# ----------------- SonarCloud token (optional) ----------------- #
# Used by each service's scripts/test to show the SonarCloud Quality Gate for your branch.
# Picked up from your current shell if you already export it, otherwise asked for until set.
if [[ -z "${SONAR_TOKEN:-}" ]]; then
  echo
  echo "🔍 SonarCloud token (optional, leave blank to skip for now)"
  echo "   Lets scripts/test show your branch's SonarCloud Quality Gate before you push."
  echo "   Generate one at https://sonarcloud.io/account/security (you must be in the defra organisation)."
fi
prompt_if_empty SONAR_TOKEN "Enter your SonarCloud token: "

check_sonar_token() {
  local valid orgs
  valid=$(curl -sS --max-time 10 -u "${SONAR_TOKEN}:" https://sonarcloud.io/api/authentication/validate 2>/dev/null || true)
  if [[ "$valid" != *'"valid":true'* ]]; then
    echo "⚠️  SonarCloud did not accept that token. Check it, then run ./setup -r to enter it again."
    return 0
  fi
  orgs=$(curl -sS --max-time 10 -u "${SONAR_TOKEN}:" "https://sonarcloud.io/api/organizations/search?member=true&ps=500" 2>/dev/null || true)
  if [[ "$orgs" != *'"key":"defra"'* ]]; then
    echo "⚠️  Token works, but your account is not in the defra SonarCloud organisation. Ask a lead to add you."
    return 0
  fi
  echo "✅ SonarCloud token check passed."
}

if [[ -n "${SONAR_TOKEN}" ]]; then
  check_sonar_token
fi

# Output inputs to config file if values are not null
if [[ "$inputEmpty" == true ]]; then
  cat >"$config_file" <<EOF
# Auto-generated on $(date +"%Y-%m-%d %H:%M:%S")
KEYVAULT="${KEYVAULT}"
EMAIL="${EMAIL}"
SUFFIX="${SUFFIX}"
SONAR_TOKEN="${SONAR_TOKEN}"
EOF
  chmod 600 "$config_file"
  echo "💾 Saved configuration to $config_file"
fi

# ----------------- Paths & Backup ----------------- #
timestamp=$(date +%Y%m%d%H%M%S)
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bashrc="$HOME/.bashrc"
backup="$HOME/backup/bashrc.backup.$timestamp"

# ----------------- Spinner ----------------- #
spinner() {
  local pid=$1 delay=0.1
  local spinstr='|/-\\'
  while kill -0 "$pid" 2>/dev/null; do
    printf " [%c]  " "${spinstr:0:1}"
    spinstr="${spinstr:1}${spinstr:0:1}"
    sleep "$delay"
    printf "\b\b\b\b\b\b"
  done
  printf "    \b\b\b\b"
}

fail_and_restore() {
  echo
  echo "⚠️  Setup failed. Restoring original .bashrc..."
  [[ -f "$backup" ]] && cp "$backup" "$bashrc" && echo "✅ Restored from $backup"
  exit 1
}

msg_with_spinner() {
  local desc=$1; shift
  echo "$desc"
  ("$@") &
  local pid=$!
  spinner "$pid"
  wait "$pid" || fail_and_restore
}

trap 'fail_and_restore' ERR

# ----------------- Azure Login Check ----------------- #
check_azure_login() {
  # Attempt to get the current account name
  account_name=$(az account show --query "name" -o tsv 2>/dev/null) || {
    echo "❌ You are not logged into Azure. Please login to the Defra Dev Tenant."
    exit 1
  }

  required_account_name="DEV"  # Change to the exact account name you expect

  # Check if the account name contains "DEV"
  if [[ "$account_name" != *"$required_account_name"* ]]; then
    echo "❌ You are logged into the wrong Azure account ($account_name)."
    echo "   Please login to the Defra Dev Tenant."
    exit 1
  fi

  echo "✅ Azure login check passed."
}


msg_with_spinner "🔎 Checking Azure login..." check_azure_login


# ----------------- Begin Setup ----------------- #
echo "📦 Backing up existing .bashrc (if any)..."
if [[ -f "$bashrc" ]]; then
  mkdir -p "$(dirname "$backup")"
  cp "$bashrc" "$backup"
else
  echo "🧾 No existing .bashrc found."
fi

echo "✅ Copying template .bashrc..."
cp "$script_dir/.bashrc" "$bashrc"

# ----------------- Add User Inputs ----------------- #
inject_inputs() {
  sed -i \
    -e "s|__EMAIL_PLACEHOLDER__|${EMAIL}|g" \
    -e "s|__SUFFIX_PLACEHOLDER__|-${SUFFIX}|g" \
    -e "s|__POSTGRES_USER_PLACEHOLDER__|${EMAIL%@*}@defra.onmicrosoft.com|g" \
    "$bashrc"

  if [[ -n "${SONAR_TOKEN}" ]]; then
    sed -i "s|__SONAR_TOKEN_PLACEHOLDER__|${SONAR_TOKEN}|g" "$bashrc"
  else
    sed -i "s|^export SONAR_TOKEN=__SONAR_TOKEN_PLACEHOLDER__|# export SONAR_TOKEN=  #? Not set, run ./setup in ffc-pay-core to add it|" "$bashrc"
  fi
}
msg_with_spinner "✍️  Injecting user inputs..." inject_inputs

# ----------------- Fetch & Add Secrets ----------------- #
declare -A secrets=(
  ["__MESSAGE_QUEUE_HOST_PLACEHOLDER__"]="ffc-bashrc-message-queue-host"
  ["__MESSAGE_QUEUE_USER_PLACEHOLDER__"]="ffc-bashrc-message-queue-user"
  ["__MESSAGE_QUEUE_PASSWORD_PLACEHOLDER__"]="ffc-bashrc-message-queue-password"
  ["__AZURE_STORAGE_SHARE_ACCOUNT_NAME_PLACEHOLDER__"]="ffc-bashrc-azure-storage-share-account-name"
  ["__TEST_NOTIFY_API_KEY_PLACEHOLDER__"]="ffc-bashrc-notify-api-key-test"
  ["__SMOKE_NOTIFY_API_KEY_PLACEHOLDER__"]="ffc-bashrc-notify-api-key-smoke"
  ["__NOTIFY_API_KEY_LETTER_PLACEHOLDER__"]="ffc-bashrc-notify-api-key-letter-test"
  ["__NOTIFY_EMAIL_TEMPLATE_KEY_PLACEHOLDER__"]="ffc-bashrc-notify-email-template-key-local"
  ["__POSTGRES_USERNAME_PLACEHOLDER__"]="ffc-bashrc-postgres-username"
  ["__POSTGRES_PASSWORD_PLACEHOLDER__"]="ffc-bashrc-postgres-password"
  ["__POSTGRES_DEV_ADMIN_PLACEHOLDER__"]="ffc-bashrc-postgres-dev-admin"
  ["__POSTGRES_DEV_HOST_PLACEHOLDER__"]="ffc-bashrc-postgres-dev-host"
  ["__POSTGRES_DEV_DATA_DB_PLACEHOLDER__"]="ffc-bashrc-postgres-dev-data-db"
  ["__POSTGRES_TEST_DATA_DB_PLACEHOLDER__"]="ffc-bashrc-postgres-test-data-db"
  ["__DEV_TENANT_PLACEHOLDER__"]="ffc-bashrc-dev-tenant"
  ["__DEV_TENANT_ID_PLACEHOLDER__"]="ffc-bashrc-dev-tenant-id"
)

fetch_secrets() {
  for placeholder in "${!secrets[@]}"; do
    local name=${secrets[$placeholder]}
    value=$(az keyvault secret show \
      --vault-name "$KEYVAULT" \
      --name "$name" \
      --query value -o tsv 2>/dev/null) || {
        echo "❌ Secret '$name' not found in Key Vault '$KEYVAULT'."
        return 1
      }
    sed -i "s|$placeholder|$value|g" "$bashrc"
  done
}
msg_with_spinner "🔐 Fetching and injecting secrets from Key Vault..." fetch_secrets

# ----------------- Source .bashrc and Cleanup trap ----------------- #
trap - ERR
echo
echo -e "\033[1;32m✅ Setup complete!\033[0m"
echo -e "\033[1;33m👉 To apply changes, run:\033[0m"
echo -e "\033[1;36m   source ~/.bashrc\033[0m"
if [[ -z "${SONAR_TOKEN}" ]]; then
  echo
  echo -e "\033[1;33m🔍 No SonarCloud token set, so scripts/test won't show the Quality Gate.\033[0m"
  echo "   Run ./setup again when you have one."
fi
echo
