#!/usr/bin/env bash
# Run the same shell command across every payment service repo on a given branch.
. "$(dirname "$0")/lib.sh"

show_help() {
  cat <<EOF
    Usage: path/to/ffc-pay-core/devtools/run -b <branch> -x "<command>" [OPTION...]
    Run <command> in the root of every payment service repo currently on <branch>.

    Options:
      -b <branch>      only include repos currently on this branch (required)
      -x "<command>"   shell command to run in each repo (required)
      -y               skip confirmation prompts
      -g <group>       only include payments, documents, pds or all repos (default: all)
      -h, --help       display this help text

    Example:
      ./devtools/run -b DOC-1234 -x "npm i && npm audit fix"
EOF
}

[[ $1 == --help ]] && { show_help; exit; }

branch=""
command=""
group="all"

while getopts "b:x:yg:h" opt; do
  case $opt in
    b) branch=$OPTARG ;;
    x) command=$OPTARG ;;
    y) yes=true ;;
    g) group=$OPTARG ;;
    h) show_help; exit ;;
    *) show_help; exit 1 ;;
  esac
done

use_group "$group" || exit 1

if [[ -z $branch || -z $command ]]; then
  echo "Error: -b and -x are required"; show_help; exit 1
fi

targets=()
for repo in "${repos[@]}"; do
  is_cloned "$repo" || continue
  on_branch "$repo" "$branch" || continue
  targets+=("$repo")
done

if ((!${#targets[@]})); then
  echo "No repos on '$branch'"; exit
fi

echo "Repos on '$branch': ${targets[*]}"
confirm "Run '$command' in ${#targets[@]} repos?" || exit

succeeded=()
failed=()

for repo in "${targets[@]}"; do
  echo; echo "===== $repo: $command"
  if (cd "$projectRoot/$repo" && bash -c "$command"); then
    succeeded+=("$repo")
  else
    echo "!! $repo: exited with status $?"; failed+=("$repo")
  fi
done

echo
echo "Succeeded: ${succeeded[*]:-none}"
echo "Failed:    ${failed[*]:-none}"

