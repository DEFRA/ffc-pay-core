#!/usr/bin/env bash
# Open a pull request for a given branch across every payment service repo on that branch.
. "$(dirname "$0")/lib.sh"

show_help() {
  cat <<EOF
    Usage: path/to/ffc-pay-core/devtools/create-pr -b <branch> -t "<title>" [OPTION...]
    Create a GitHub pull request in every payment service repo currently on <branch>.
    The branch must already be pushed. Requires the GitHub CLI (gh), logged in.

    Options:
      -b <branch>      only include repos currently on this branch (required)
      -t "<title>"     pull request title used for every repo (required)
      -d "<text>"      pull request description (default: empty)
      -s <base>        branch to merge into (default: main)
      -D               create as draft
      -y               skip confirmation prompts
      -g <group>       only include payments, documents, pds or all repos (default: all)
      -h, --help       display this help text

    Example:
      ./devtools/create-pr -b DOC-1234 -t "DOC-1234: migrate to Knex" -d "See DOC-1234" -D
EOF
}

[[ $1 == --help ]] && { show_help; exit; }

branch=""
title=""
body=""
base="main"
draft=()
group="all"

while getopts "b:t:d:s:Dyg:h" opt; do
  case $opt in
    b) branch=$OPTARG ;;
    t) title=$OPTARG ;;
    d) body=$OPTARG ;;
    s) base=$OPTARG ;;
    D) draft=(--draft) ;;
    y) yes=true ;;
    g) group=$OPTARG ;;
    h) show_help; exit ;;
    *) show_help; exit 1 ;;
  esac
done

use_group "$group" || exit 1

if [[ -z $branch || -z $title ]]; then
  echo "Error: -b and -t are required"; show_help; exit 1
fi

if ! command -v gh > /dev/null; then
  echo "Error: the GitHub CLI (gh) is required - https://cli.github.com"; exit 1
fi

if ! gh auth status > /dev/null 2>&1; then
  echo "Error: not logged in to GitHub - run 'gh auth login'"; exit 1
fi

created=()
existing=()
skipped=()
failed=()

for repo in "${repos[@]}"; do
  is_cloned "$repo" || continue
  on_branch "$repo" "$branch" || continue
  dir="$projectRoot/$repo"

  if ! remote_branch_exists "$repo" "$branch"; then
    echo "!! $repo: '$branch' is not pushed to origin - skipping"; skipped+=("$repo"); continue
  fi

  if ! git -C "$dir" fetch --quiet origin "$base" "$branch"; then
    echo "!! $repo: could not fetch from origin"; failed+=("$repo"); continue
  fi

  url=$(cd "$dir" && gh pr list --head "$branch" --base "$base" --state open --json url --jq '.[0].url')
  if [[ -n $url ]]; then
    echo "-- $repo: pull request already open - $url"; existing+=("$url"); continue
  fi

  if [[ $(git -C "$dir" rev-list --count "origin/$base..origin/$branch") == 0 ]]; then
    echo "-- $repo: no commits ahead of $base - skipping"; skipped+=("$repo"); continue
  fi

  echo; echo "===== $repo ($branch -> $base)"
  git -C "$dir" --no-pager log --oneline "origin/$base..origin/$branch"
  unpushed=$(git -C "$dir" rev-list --count "origin/$branch..HEAD")
  if ((unpushed)); then
    echo "!! $unpushed local commit(s) not pushed - they won't be in the pull request"
  fi

  if ! confirm "Create pull request for $repo?"; then
    echo "skipped"; skipped+=("$repo"); continue
  fi

  if url=$(cd "$dir" && gh pr create --base "$base" --head "$branch" --title "$title" --body "$body" "${draft[@]}"); then
    echo "$url"; created+=("$url")
  else
    failed+=("$repo")
  fi
done

echo
echo "Created:"
printf '  %s\n' "${created[@]:-none}"
echo "Already open:"
printf '  %s\n' "${existing[@]:-none}"
echo "Skipped: ${skipped[*]:-none}"
echo "Failed:  ${failed[*]:-none}"
